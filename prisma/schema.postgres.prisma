generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String             @id @default(cuid())
  name                   String?
  email                  String             @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   String             @default("Creator") // Admin, Creator, Viewer
  plan                   String             @default("FREE") // FREE, PLUS_MONTHLY, PLUS_QUARTERLY, PLUS_ANNUAL
  queriesRemaining       Int                @default(3)
  aiProRemaining         Int                @default(1)
  atlasCreditsRemaining  Int                @default(10)
  courseCreatesRemaining Int                @default(3)
  invitedById            String?
  invitedBy              User?              @relation("UserInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers           User[]             @relation("UserInviter")
  revokedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  accounts               Account[]
  sessions               Session[]
  sentInvitations        Invitation[]       @relation("InvitedByAdmin")
  acceptedInvitation     Invitation?        @relation("AcceptedByUser")
  auditLogs              AuditLog[]         @relation("AuditActor")
  homeworkQuestions      HomeworkQuestion[]
  customCourses          CustomCourse[]
  atlasSessions          AtlasSessionRecord[]
  customWorldMapPois     CustomWorldMapPoi[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  activeForEmail String?   @unique
  tokenHash      String    @unique
  role           String    @default("Creator") // Admin, Creator, Viewer
  status         String    @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  invitedById    String
  invitedBy      User      @relation("InvitedByAdmin", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById   String?   @unique
  acceptedBy     User?     @relation("AcceptedByUser", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model HomeworkQuestion {
  id              String   @id @default(cuid())
  questionText    String
  subject         String   @default("Math")
  imageDataUrl    String?
  answerSummary   String
  explanation     String
  keyConceptsJson String
  stepsJson       String
  isProVerified   Boolean  @default(false)
  helpfulCount    Int      @default(0)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model CustomCourse {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subtitle        String
  category        String   @default("my")
  discipline      String   @default("AI Course")
  blocksJson      String
  progressPercent Int      @default(0)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model AtlasSessionRecord {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  category        String   @default("History")
  chaptersJson    String
  videoConfigJson String?
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model CustomWorldMapPoi {
  id        String   @id @default(cuid())
  title     String
  summary   String
  region    String
  category  String   @default("Politics") // Person, Politics, Economy, Other
  startYear Int      @default(1877)
  endYear   Int      @default(1877)
  lat       Float    @default(38.9)
  lng       Float    @default(-77.0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
